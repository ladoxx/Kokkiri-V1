# Application URL
NEXT_PUBLIC_SITE_URL="https://kokkiri.com"
PORT=3001
NODE_ENV="development"

# Database (SQLite) - Zero-config embedded database
DATABASE_URL="file:./kokkiri.db"

# Authentication & Session Security
JWT_SECRET="kokkiri-super-secret-jwt-key-change-in-production-2026-korea"
SESSION_EXPIRY="7d"

# Default Initial Administrator
ADMIN_INIT_EMAIL="admin@kokkiri.com"
ADMIN_INIT_NAME="최고 관리자"
ADMIN_INIT_PASSWORD="KokkiriAdmin2026!#"

# Email Notification Settings (SMTP)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="코끼리 비즈니스 플랫폼 <no-reply@kokkiri.com>"
NOTIFICATION_RECEIVER_EMAILS="admin@kokkiri.com,notifications@kokkiri.com"

# KakaoTalk Alimtalk Provider Settings
KAKAO_API_URL="https://api.bizmessage.kakao.com/v1"
KAKAO_API_KEY=""
KAKAO_SENDER_KEY=""
KAKAO_SENDER_PHONE="02-1234-5678"
KAKAO_TEST_MODE=true
